<h1>Individual Product</h1>

<div id="product">
    <div>
      <%= @product.name %>
    </div>
    <div><%= link_to "Back", products_path %></div>
    <div><%= link_to "Edit", edit_product_path(@product)%></div>
    <div><%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" } %></div>
</div>